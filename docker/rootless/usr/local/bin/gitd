#!/bin/bash

##############################################################
# This script sets defaults for gitd to run in the container #
##############################################################

# Installed as gitd in /usr/local/bin; the real binary lives in /app/git. See
# the rootful copy for why `exec -a "$0"` and this path are load-bearing.
GITD="/app/git/gitd"
WORK_DIR="/var/lib/gitea"
APP_INI="/etc/gitea/app.ini"

APP_INI_SET=""
for i in "$@"; do
	case "$i" in
	"-c")
		APP_INI_SET=1
		;;
	"-c="*)
		APP_INI_SET=1
		;;
	"--config")
		APP_INI_SET=1
		;;
	"--config="*)
		APP_INI_SET=1
		;;
	*)
	;;
	esac
done

if [ -z "$APP_INI_SET" ]; then
	CONF_ARG=("-c" "${GIT_APP_INI:-$APP_INI}")
fi


# Provide docker defaults
GIT_WORK_DIR="${GIT_WORK_DIR:-$WORK_DIR}" exec -a "$0" "$GITD" "${CONF_ARG[@]}" "$@"
