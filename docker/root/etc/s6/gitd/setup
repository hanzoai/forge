#!/bin/bash

if [ ! -d /data/git/.ssh ]; then
    mkdir -p /data/git/.ssh
fi

# Set the correct permissions on the .ssh directory and authorized_keys file,
# or sshd will refuse to use them and lead to clone/push/pull failures.
# It could happen when users have copied their data to a new volume and changed the file permission by accident,
# and it would be very hard to troubleshoot unless users know how to check the logs of sshd which is started by s6.
chmod 700 /data/git/.ssh
if [ -f /data/git/.ssh/authorized_keys ]; then
    chmod 600 /data/git/.ssh/authorized_keys
fi

if [ ! -f /data/git/.ssh/environment ]; then
    echo "GIT_CUSTOM=$GIT_CUSTOM" >| /data/git/.ssh/environment
    chmod 600 /data/git/.ssh/environment

elif ! grep -q "^GIT_CUSTOM=$GIT_CUSTOM$" /data/git/.ssh/environment; then
    sed -i /^GIT_CUSTOM=/d /data/git/.ssh/environment
    echo "GIT_CUSTOM=$GIT_CUSTOM" >> /data/git/.ssh/environment
fi

if [ ! -f ${GIT_CUSTOM}/conf/app.ini ]; then
    mkdir -p ${GIT_CUSTOM}/conf

    # Set INSTALL_LOCK to true only if SECRET_KEY is not empty and
    # INSTALL_LOCK is empty
    if [ -n "$SECRET_KEY" ] && [ -z "$INSTALL_LOCK" ]; then
        INSTALL_LOCK=true
    fi

    # Substitute the environment variables in the template
    # APP_NAME is passed through empty on purpose: the default lives in one place,
    # setting.AppName, so the container cannot brand the site title differently.
    APP_NAME=${APP_NAME:-""} \
    RUN_MODE=${RUN_MODE:-"prod"} \
    DOMAIN=${DOMAIN:-"localhost"} \
    SSH_DOMAIN=${SSH_DOMAIN:-"localhost"} \
    HTTP_PORT=${HTTP_PORT:-"3000"} \
    ROOT_URL=${ROOT_URL:-""} \
    DISABLE_SSH=${DISABLE_SSH:-"false"} \
    SSH_PORT=${SSH_PORT:-"22"} \
    SSH_LISTEN_PORT=${SSH_LISTEN_PORT:-"${SSH_PORT}"} \
    LFS_START_SERVER=${LFS_START_SERVER:-"false"} \
    DB_TYPE=${DB_TYPE:-"sqlite3"} \
    DB_HOST=${DB_HOST:-"localhost:3306"} \
    DB_NAME=${DB_NAME:-"hanzo_git"} \
    DB_USER=${DB_USER:-"root"} \
    DB_PASSWD=${DB_PASSWD:-""} \
    INSTALL_LOCK=${INSTALL_LOCK:-"false"} \
    DISABLE_REGISTRATION=${DISABLE_REGISTRATION:-"false"} \
    REQUIRE_SIGNIN_VIEW=${REQUIRE_SIGNIN_VIEW:-"false"} \
    SECRET_KEY=${SECRET_KEY:-""} \
    envsubst < /etc/templates/app.ini > ${GIT_CUSTOM}/conf/app.ini

    chown ${USER}:git ${GIT_CUSTOM}/conf/app.ini
fi

# Replace app.ini settings with env variables in the form GIT__SECTION_NAME__KEY_NAME
# Fatal on failure: every deploy configures this server through GIT__* env alone,
# so a server that starts without the merge runs on whatever app.ini the volume
# happened to keep — the failure this line used to swallow.
environment-to-ini --config ${GIT_CUSTOM}/conf/app.ini || exit 1

# only chown if current owner is not already the ${USER}. No recursive check, to
# save time. /data holds the durable layout and /app/git the daemon binary. A
# volume an earlier release wrote keeps its own app.ini, and so its own data
# path, which is why a directory that is not there is skipped rather than made.
for dir in /data/forge /app/git /data/git; do
	[[ -d ${dir} ]] || continue
	if ! [[ $(ls -ld ${dir} | awk '{print $3}') = ${USER} ]]; then chown -R ${USER}:git ${dir}; fi
	chmod 0755 ${dir}
done
